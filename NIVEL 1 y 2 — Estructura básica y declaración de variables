#include <iostream>
#include <string>
#include <limits>

using namespace std;

int main() {
    int opcion;

    do {
        // Menú principal
        cout << "\n=== SISTEMA DE CALIFICACIONES ===" << endl;
        cout << "1. Registrar estudiante" << endl;
        cout << "2. Ver informacion del programa" << endl;
        cout << "3. Salir" << endl;
        cout << "Opcion: ";
        cin >> opcion;

        switch (opcion) {
            case 1: {
                string nombre;
                int edad;
                int num_calificaciones;
                float calificacion;
                float suma = 0, promedio = 0;
                
                // Variables para encontrar máxima, mínima y contar aprobadas/reprobadas
                float maxima = -1.0; 
                float minima = 11.0;
                int aprobadas = 0;
                int reprobadas = 0;

                // Limpiar el buffer antes de usar getline
                cin.ignore(numeric_limits<streamsize>::max(), '\n');

                cout << "\nNombre del estudiante: ";
                getline(cin, nombre);
                
                cout << "Edad: ";
                cin >> edad;
                // Ciclo while para validar la edad
                while (edad < 0 || edad > 120) {
                    cout << "Edad invalida. Vuelve a ingresar una edad valida (0-120): ";
                    cin >> edad;
                }

                // Pregunta dinámica
                cout << "Cuantas calificaciones deseas registrar? ";
                cin >> num_calificaciones;

                if (num_calificaciones <= 0) {
                    cout << "Cantidad invalida. Cancelando registro..." << endl;
                    break;
                }

                // Ciclo FOR para n calificaciones
                for (int i = 1; i <= num_calificaciones; i++) {
                    cout << "Calificacion " << i << ": ";
                    cin >> calificacion;

                    // Ciclo while para validar cada calificación
                    while (calificacion < 0 || calificacion > 10) {
                        cout << "Calificacion invalida. Vuelve a ingresar la calificacion " << i << " (0-10): ";
                        cin >> calificacion;
                    }

                    // Acumular la suma
                    suma += calificacion;

                    // Contar aprobadas y reprobadas (asumiendo >= 6 como aprobatorio)
                    if (calificacion >= 6) {
                        aprobadas++;
                    } else {
                        reprobadas++;
                    }

                    // Encontrar la calificación más alta y más baja sin arreglos
                    if (calificacion > maxima) {
                        maxima = calificacion;
                    }
                    if (calificacion < minima) {
                        minima = calificacion;
                    }
                }

                promedio = suma / num_calificaciones;

                string estado;
                if (promedio >= 9) {
                    estado = "EXCELENTE";
                } else if (promedio >= 7) {
                    estado = "APROBADO";
                } else if (promedio >= 6) {
                    estado = "REGULAR (aprobado con lo minimo)";
                } else {
                    estado = "REPROBADO";
                }

                // Resumen actualizado
                cout << "\nResumen del estudiante" << endl;
                cout << "Nombre: " << nombre << endl;
                cout << "Edad: " << edad << endl;
                cout << "Promedio: " << promedio << endl;
                cout << "Estado: " << estado << endl;
                cout << "Calificacion mas alta: " << maxima << endl;
                cout << "Calificacion mas baja: " << minima << endl;
                cout << "Calificaciones aprobatorias: " << aprobadas << endl;
                cout << "Calificaciones reprobatorias: " << reprobadas << endl;
                break;
            }
            case 2:
                cout << "\n--- Informacion del programa ---" << endl;
                cout << "Este programa permite registrar a un estudiante," << endl;
                cout << "calcular su promedio en base a 'n' calificaciones usando ciclos," << endl;
                cout << "y determinar su estado academico junto con estadisticas de sus notas." << endl;
                break;
            case 3:
                cout << "\nSaliendo del programa..." << endl;
                break;
            default:
                cout << "\nOpcion invalida. Por favor, selecciona una opcion del 1 al 3." << endl;
        }
    } while (opcion != 3);

    return 0;
}
